{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ougi-arena/client", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "server-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ougi-arena/server", "dev"],
      "port": 2567
    },
    {
      "name": "client-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ougi-arena/client",
        "exec",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
