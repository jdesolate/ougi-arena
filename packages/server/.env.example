# Port to bind. Render sets this automatically; local dev defaults to 2567.
PORT=2567

# Comma-separated browser origins allowed to reach the room list and open a socket.
# Unset means any origin (the dev default, since Vite runs on a different port).
ALLOWED_ORIGINS=https://ougi-arena.pages.dev

# Fake round-trip latency in ms, for feel testing. 0 or unset disables it.
SIMULATE_LATENCY_MS=0
