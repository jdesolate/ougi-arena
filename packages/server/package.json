{
  "name": "@ougi-arena/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:@colyseus/* --external:colyseus",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@ougi-arena/shared": "workspace:*",
    "@colyseus/core": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "colyseus": "^0.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.0"
  }
}
